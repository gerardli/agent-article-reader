{
  "name": "agent-article-reader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local MCP server and Codex skill for extracting articles the user is authorized to access.",
  "type": "module",
  "bin": {
    "agent-article-reader": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.2.0",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "24.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
